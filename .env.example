# 仅用于本地脱敏测试；生产环境必须显式关闭开发登录。
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_PATH=.data/prepaid-refund.db
PRIVATE_STORAGE_PATH=storage/private
GENERATED_STORAGE_PATH=storage/generated
DEV_AUTH_ENABLED=true
DEV_AUTH_SECRET=replace-with-at-least-32-random-characters
DEV_USER_PASSWORD=change-me-user
DEV_REVIEWER_PASSWORD=change-me-reviewer
DEV_ADMIN_PASSWORD=change-me-admin
EXTRACTION_PROVIDER=mock
OCR_PROVIDER=mock
MODEL_MAX_RETRIES=2
MODEL_REDACTION_ENABLED=true
PDF_FONT_PATH=
RETENTION_DAYS=30
MAX_UPLOAD_BYTES=10485760
MAX_FILES_PER_CASE=30

